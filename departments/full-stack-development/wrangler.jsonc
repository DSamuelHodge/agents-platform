{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-full-stack-development",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "MCP_GATEWAY",
      "service": "agents-mcp-gateway"
    }
  ],
  "vars": {
    "DEPARTMENT": "full-stack-development"
  },
  "migrations": [
    {
      "tag": "flue-class-FlueFullStackLeadAgent",
      "new_sqlite_classes": [
        "FlueFullStackLeadAgent"
      ]
    },
    {
      "tag": "flue-class-FlueFullStackDeveloperAgent",
      "new_sqlite_classes": [
        "FlueFullStackDeveloperAgent"
      ]
    },
    {
      "tag": "flue-class-FlueMeanMernStackDeveloperAgent",
      "new_sqlite_classes": [
        "FlueMeanMernStackDeveloperAgent"
      ]
    },
    {
      "tag": "flue-class-FlueRapidPrototyperAgent",
      "new_sqlite_classes": [
        "FlueRapidPrototyperAgent"
      ]
    }
  ]
}

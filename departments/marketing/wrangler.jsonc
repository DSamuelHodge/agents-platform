{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-marketing",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "MCP_GATEWAY",
      "service": "agents-mcp-gateway"
    }
  ],
  "vars": {
    "DEPARTMENT": "marketing"
  },
  "migrations": [
    {
      "tag": "flue-class-FlueChiefMarketingOfficerAgent",
      "new_sqlite_classes": [
        "FlueChiefMarketingOfficerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueProductMarketingManagerAgent",
      "new_sqlite_classes": [
        "FlueProductMarketingManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueContentMarketingManagerAgent",
      "new_sqlite_classes": [
        "FlueContentMarketingManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueDigitalMarketingSpecialistAgent",
      "new_sqlite_classes": [
        "FlueDigitalMarketingSpecialistAgent"
      ]
    },
    {
      "tag": "flue-class-FlueGrowthMarketerAgent",
      "new_sqlite_classes": [
        "FlueGrowthMarketerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueEmailMarketingSpecialistAgent",
      "new_sqlite_classes": [
        "FlueEmailMarketingSpecialistAgent"
      ]
    },
    {
      "tag": "flue-class-FlueMarketingAnalystAgent",
      "new_sqlite_classes": [
        "FlueMarketingAnalystAgent"
      ]
    },
    {
      "tag": "flue-class-FlueBrandManagerAgent",
      "new_sqlite_classes": [
        "FlueBrandManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueEventMarketingManagerAgent",
      "new_sqlite_classes": [
        "FlueEventMarketingManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FluePartnerMarketingManagerAgent",
      "new_sqlite_classes": [
        "FluePartnerMarketingManagerAgent"
      ]
    }
  ]
}

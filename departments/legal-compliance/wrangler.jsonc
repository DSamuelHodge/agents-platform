{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-legal-compliance",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "MCP_GATEWAY",
      "service": "agents-mcp-gateway"
    }
  ],
  "vars": {
    "DEPARTMENT": "legal-compliance"
  },
  "migrations": [
    {
      "tag": "flue-class-FlueGeneralCounselAgent",
      "new_sqlite_classes": [
        "FlueGeneralCounselAgent"
      ]
    },
    {
      "tag": "flue-class-FlueCorporateLawyerAgent",
      "new_sqlite_classes": [
        "FlueCorporateLawyerAgent"
      ]
    },
    {
      "tag": "flue-class-FluePrivacyOfficerAgent",
      "new_sqlite_classes": [
        "FluePrivacyOfficerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueIntellectualPropertyAttorneyAgent",
      "new_sqlite_classes": [
        "FlueIntellectualPropertyAttorneyAgent"
      ]
    },
    {
      "tag": "flue-class-FlueComplianceManagerAgent",
      "new_sqlite_classes": [
        "FlueComplianceManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueContractManagerAgent",
      "new_sqlite_classes": [
        "FlueContractManagerAgent"
      ]
    },
    {
      "tag": "flue-class-FlueParalegalAgent",
      "new_sqlite_classes": [
        "FlueParalegalAgent"
      ]
    }
  ]
}

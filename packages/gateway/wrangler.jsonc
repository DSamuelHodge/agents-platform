{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Private by design: reachable only through service bindings from department Workers.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
  // Secrets (see scripts/provision-secrets.sh):
  //   DEPT_KEYS          JSON map { "<department>": "<hmac key>" }
  //   MCP_TOKEN_<ID>     upstream credential per catalog server, ID uppercased, '-' -> '_'
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-live-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "services": [
    { "binding": "MCP_GATEWAY", "service": "agents-mcp-gateway" }
  ]
}

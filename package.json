{
  "name": "agents-platform",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "departments/*"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build-policy": "node scripts/build-policy.mjs",
    "build-policy:check": "node scripts/build-policy.mjs --check",
    "sync-skills": "node scripts/sync-skills.mjs",
    "create-gateways": "node scripts/create-ai-gateways.mjs",
    "list-mcp-tools": "node scripts/list-mcp-tools.mjs",
    "put-mcp-tokens": "node scripts/put-mcp-tokens.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test --experimental-strip-types \"packages/*/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "check": "npm run validate && npm run generate:check && npm run build-policy:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "latest",
    "@flue/runtime": "2.2.2",
    "@flue/vite": "2.2.2",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "wrangler": "^4.143.0"
  }
}
